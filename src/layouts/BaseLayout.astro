---
import '../styles/global.css';
import '../styles/responsive-fix.css';
import '../styles/polish.css';
import '../styles/contact-form.css';
import '../styles/blog.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'TundeCodes — Software Engineer',
  description = 'Software engineer and researcher specializing in software verification, programming languages, and reliable AI-generated code.',
  image = '/images/tunde-portrait.jpg?v=6',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const pathname = Astro.url.pathname;
const resumeUrl = '/resume.pdf';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sodiq Babatunde Ologun',
  alternateName: 'TundeCodes',
  url: String(new URL('/', Astro.site ?? Astro.url.origin)),
  image: String(socialImage),
  jobTitle: 'Software Engineer and Researcher',
  sameAs: [
    'https://github.com/xohdik',
    'https://github.com/reliablecodes',
    'https://www.linkedin.com/in/ologunbabatunde',
  ],
  knowsAbout: [
    'Software Verification',
    'Programming Languages',
    'Formal Analysis',
    'Program Graphs',
    'Neuro-symbolic Reasoning',
    'Code Intelligence',
    'Software Engineering',
    'Software Reliability',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#efeee8" />
    <meta name="description" content={description} />
    <meta name="author" content="Sodiq Babatunde Ologun" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Sodiq Babatunde Ologun — TundeCodes / ReliableCode Group" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Sodiq Babatunde Ologun — TundeCodes / ReliableCode Group" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/debug-playground.css" />
    <link rel="stylesheet" href="/bug-hunt.css" />
    <link rel="stylesheet" href="/easter-egg.css" />
    <link rel="stylesheet" href="/build-pipeline.css" />
    <link rel="stylesheet" href="/moving-text.css" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="TundeCodes home">TUNDE<span>CODES</span></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="/work" aria-current={pathname.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/research" aria-current={pathname.startsWith('/research') ? 'page' : undefined}>Research</a>
        <a href="/blog" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
        <a href="/#debug-playground">Play</a>
        <a href="/#experience">Experience</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <a class="lab-link desktop-only" href="https://github.com/reliablecodes" target="_blank" rel="noreferrer">RELIABLECODE GROUP ↗</a>
        <span class="debug-status desktop-only motion-pulse" title="Debug mode"><i></i> DEBUG MODE</span>
        <a class="text-link desktop-only" href={resumeUrl} target="_blank" rel="noreferrer">Résumé ↗</a>
        <button class="menu-button" aria-label="Open navigation menu" aria-expanded="false">Menu</button>
      </div>
    </header>

    <div class="motion-strip" aria-label="ReliableCode focus areas">
      <div class="motion-track">
        <div class="motion-group">
          <span>DEBUG · BUILD · VERIFY</span><span>SOFTWARE VERIFICATION</span><span>PROGRAMMING LANGUAGES</span><span>CODE INTELLIGENCE</span><span>NEURO-SYMBOLIC ANALYSIS</span><span>RELIABLE SYSTEMS</span>
        </div>
        <div class="motion-group" aria-hidden="true">
          <span>DEBUG · BUILD · VERIFY</span><span>SOFTWARE VERIFICATION</span><span>PROGRAMMING LANGUAGES</span><span>CODE INTELLIGENCE</span><span>NEURO-SYMBOLIC ANALYSIS</span><span>RELIABLE SYSTEMS</span>
        </div>
      </div>
    </div>

    <div class="mobile-menu" aria-hidden="true">
      <div class="mobile-menu-status"><span></span> DEBUG MODE</div>
      <a href="/work">Work</a>
      <a href="/research">Research</a>
      <a href="/blog">Blog</a>
      <a href="/#debug-playground">Debug Playground</a>
      <a href="/#bug-hunt">Bug Hunt</a>
      <a href="/#build-pipeline">Build Pipeline</a>
      <a href="/#experience">Experience</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
      <a href="https://github.com/reliablecodes" target="_blank" rel="noreferrer">ReliableCode Group ↗</a>
      <a href={resumeUrl} target="_blank" rel="noreferrer">Résumé ↗</a>
    </div>

    <main id="content">
      <slot />
    </main>

    <div class="motion-strip alt" aria-label="ReliableCode engineering principles">
      <div class="motion-track">
        <div class="motion-group">
          <span>FIND THE FAILURE</span><span>TRACE THE MECHANISM</span><span>FIX THE ROOT CAUSE</span><span>VERIFY THE BEHAVIOR</span><span>SHIP WITH EVIDENCE</span>
        </div>
        <div class="motion-group" aria-hidden="true">
          <span>FIND THE FAILURE</span><span>TRACE THE MECHANISM</span><span>FIX THE ROOT CAUSE</span><span>VERIFY THE BEHAVIOR</span><span>SHIP WITH EVIDENCE</span>
        </div>
      </div>
    </div>

    <footer class="site-footer section-shell">
      <div class="footer-mark">TUNDE<span>CODES</span></div>
      <div>
        <span>DEBUG · BUILD · VERIFY</span>
        <a href="/blog">BLOG ↗</a>
        <a href="/#debug-playground">DEBUG PLAYGROUND ↗</a>
        <a href="/#bug-hunt">BUG HUNT ↗</a>
        <a href="/#build-pipeline">BUILD PIPELINE ↗</a>
        <span>RELIABLECODE GROUP · SOFTWARE ENGINEER · RESEARCHER</span>
        <span class="visit-counter" aria-live="polite">VIEWS / <b id="visit-count">—</b></span>
        <span>© 2026</span>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector('.menu-button');
      const mobileMenu = document.querySelector('.mobile-menu');
      const menuLinks = document.querySelectorAll('.mobile-menu a');

      const closeMenu = () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        mobileMenu?.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('menu-open');
      };

      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        mobileMenu?.setAttribute('aria-hidden', String(open));
        document.body.classList.toggle('menu-open', !open);
      });
      menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });

      document.documentElement.classList.add('js-ready');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reducedMotion) {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px' });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
    </script>
    <script is:inline src="/contact-form.js" defer></script>
    <script is:inline src="/debug-playground.js" defer></script>
    <script is:inline src="/bug-hunt.js" defer></script>
    <script is:inline src="/easter-egg.js" defer></script>
    <script is:inline src="/build-pipeline.js" defer></script>
    <script is:inline data-goatcounter="https://reliablecodes.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script is:inline>
      (() => {
        const target = document.getElementById('visit-count');
        if (!target) return;

        let attempts = 0;
        const timer = window.setInterval(() => {
          attempts += 1;
          if (!window.goatcounter?.visit_count) {
            if (attempts >= 80) window.clearInterval(timer);
            return;
          }

          window.clearInterval(timer);
          target.textContent = '';
          window.goatcounter.visit_count({
            append: '#visit-count',
            type: 'html',
            no_branding: true,
          });
        }, 100);
      })();
    </script>
  </body>
</html>
