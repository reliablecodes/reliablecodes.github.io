---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectedWork, researchItems, appliedProjects, experience, capabilities } from '../data/portfolio';
const resumeUrl = 'https://raw.githubusercontent.com/xohdik/xohdik.github.io/tundecodes-redesign/public/resume.pdf';
const terminalVideo = 'https://raw.githubusercontent.com/xohdik/xohdik.github.io/0bbb0d05b78438ddd73ebebf6889756396d62ce5/public/videos/hero-bg.mp4';
---

<BaseLayout
  title="TundeCodes — Software Engineer"
  description="Sodiq Babatunde Ologun is a software engineer and researcher specializing in software verification, programming languages, and reliable AI-generated code."
>
  <section class="hero section-shell">
    <div class="hero-copy reveal">
      <p class="eyebrow">RELIABLECODE GROUP · DEBUG · BUILD · VERIFY</p>
      <h1>Debugging is how I <em>think.</em></h1>
      <p class="hero-intro">I specialize in software verification and programming languages, with a focus on making AI-generated code correct, reliable, and explainable.</p>
      <div class="hero-links">
        <a class="primary-link" href="#work">Selected work <span>↓</span></a>
        <a class="plain-link" href="https://github.com/reliablecodes" target="_blank" rel="noreferrer">ReliableCode Group ↗</a>
        <a class="plain-link" href="https://github.com/xohdik" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>

    <figure class="portrait-wrap reveal delay-1">
      <div class="portrait-meta"><span>TUNDECODES · RELIABLECODE GROUP</span><span>DEBUG / 2026</span></div>
      <img src="/images/tunde-portrait.jpg?v=5" width="800" height="800" alt="Portrait of Sodiq Babatunde Ologun" loading="eager" fetchpriority="high" decoding="sync" />
      <figcaption>SODIQ BABATUNDE OLOGUN</figcaption>
    </figure>
  </section>

  <section class="lab-banner section-shell reveal" aria-label="ReliableCode Group visual identity">
    <div class="lab-banner-copy">
      <p class="section-number">RELIABLECODE GROUP</p>
      <h2>Reliable systems start with visible failure modes.</h2>
      <p>Software verification · Programming languages · Code intelligence · Neuro-symbolic analysis</p>
    </div>
    <img src="/images/reliablecode-banner.webp" alt="ReliableCode Group visual identity" loading="lazy" />
  </section>

  <section class="statement section-shell reveal">
    <p class="section-number">01 / DEBUG MINDSET</p>
    <p class="statement-copy">I work by <strong>finding what does not hold up</strong>: in product architecture, production infrastructure, data, experiments, and model evaluation. Then I build the fix.</p>
  </section>

  <section id="work" class="work-section dark-section">
    <div class="section-shell">
      <div class="section-heading reveal">
        <div><p class="section-number">02 / BUILD & DEBUG</p><h2>Real systems.<br/>Hard problems.</h2></div>
        <p>Current product engineering, production systems, and research work arranged by what best represents my engineering depth today.</p>
      </div>
      <div class="work-list">
        {selectedWork.slice(0, 5).map((project) => {
          const isAnonymous = 'anonymous' in project && project.anonymous === true;
          return isAnonymous ? (
            <a class="work-row anonymous-work reveal" href={project.href}>
              <div class="work-main"><h3>{project.title}</h3></div>
            </a>
          ) : (
            <a class="work-row reveal" href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span class="work-index">{project.index}</span>
              <div class="work-main"><h3>{project.title}</h3><p>{project.summary}</p></div>
              <div class="work-side"><span>{project.role}</span><small>{project.status} · {project.meta}</small></div>
              <span class="work-arrow">↗</span>
            </a>
          );
        })}
      </div>
      <div class="section-more reveal"><a href="/work">View all selected work ↗</a></div>
    </div>
  </section>

  <section class="engineering-console section-shell reveal">
    <div class="console-heading">
      <p class="section-number">03 / ENGINEERING CONSOLE</p>
      <p>Small traces from the way I think about production software: verify assumptions, expose failure states, and keep the path to a fix readable.</p>
    </div>
    <div class="console-grid">
      <pre><code><span class="code-comment">// verification gate</span>
const deploy = evidence =&gt;
  evidence.passes()
    ? <span class="code-accent">ship()</span>
    : debug(evidence);</code></pre>
      <pre><code><span class="code-comment"># reliability loop</span>
while system.is_live():
    failure = observe()
    if failure:
        isolate(failure)
        <span class="code-accent">fix_root_cause()</span></code></pre>
    </div>
  </section>

  <section class="terminal-video reveal" aria-label="Terminal installation session">
    <video autoplay muted loop playsinline preload="metadata" src={terminalVideo}></video>
  </section>

  <section class="project-index section-shell">
    <div class="section-heading reveal">
      <div><p class="section-number">04 / MORE BUILDS</p><h2>Applied engineering,<br/>across domains.</h2></div>
      <p>Selected systems and experiments from the broader project archive.</p>
    </div>
    <div class="project-index-list">
      {appliedProjects.slice(0, 6).map((project, i) => (
        <a class="project-index-row reveal" href={project.href ?? '/work#more-projects'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noreferrer' : undefined}>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{project.title}</h3><p>{project.description}</p></div>
          <small>{project.stack}</small>
        </a>
      ))}
    </div>
    <div class="section-more reveal"><a href="/work#more-projects">View complete project archive ↗</a></div>
  </section>

  <section id="research" class="research-section section-shell">
    <div class="section-heading reveal">
      <div><p class="section-number">05 / DEBUG THE EVIDENCE</p><h2>Question the metric.<br/>Trace the mechanism.</h2></div>
      <p>My research focuses on software behavior, code intelligence, benchmark validity, and experimental methods that make misleading conclusions harder to hide.</p>
    </div>
    <div class="research-list">
      {researchItems.map((item, i) => {
        const isAnonymous = 'anonymous' in item && item.anonymous === true;
        return isAnonymous ? (
          <article class="research-row anonymous-research reveal">
            <div><h3>{item.title}</h3></div>
          </article>
        ) : (
          <article class="research-row reveal">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{item.title}</h3><p>{item.venue}</p></div>
            <p>{item.status}</p>
          </article>
        );
      })}
    </div>
    <div class="section-more reveal"><a href="/research">View research ↗</a></div>
  </section>

  <section id="experience" class="experience-section section-shell">
    <div class="section-heading reveal">
      <div><p class="section-number">06 / EXPERIENCE</p><h2>Debugging from production to research.</h2></div>
      <p>My engineering perspective comes from operating software for real users, working with operational data, and investigating failure modes under controlled evaluation.</p>
    </div>
    <div class="experience-list">
      {experience.map(([date, role, org, desc]) => (
        <article class="experience-row reveal">
          <time>{date}</time>
          <div><h3>{role}</h3><p>{org}</p></div>
          <p>{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="section-shell about-grid">
      <div class="about-lead reveal">
        <p class="section-number">07 / ABOUT</p>
        <h2>Debugging is how I think.</h2>
      </div>
      <div class="about-copy reveal delay-1">
        <p><strong>🔻I specialize in software verification and programming languages, with a focus on making AI-generated code correct, reliable, and explainable.</strong> I develop methods that combine formal analysis, program graphs, and neuro-symbolic reasoning to ensure AI code can be trusted before deployment.</p>
        <p>◾️In the long run, I aim to contribute to the evolution of neuro-symbolic software analysis: AI systems that do not merely mimic human intuition, but reason transparently and ethically about software behavior.</p>
        <p class="about-manifesto">🔺We build the next generation of reliable computing systems.</p>
        <div class="capability-list">
          {capabilities.map((cap) => <span>{cap}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section section-shell reveal">
    <p class="section-number">08 / CONTACT</p>
    <h2>Found a difficult problem?</h2>
    <div class="contact-grid">
      <p>I'm interested in serious engineering problems, software verification, program analysis, product architecture, and systems that need to work beyond the demo.</p>
      <div class="contact-links">
        <a href="mailto:ologunbabatunde@gmail.com">Email ↗</a>
        <a href="https://github.com/xohdik" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://github.com/reliablecodes" target="_blank" rel="noreferrer">ReliableCode Group ↗</a>
        <a href="https://www.linkedin.com/in/ologunbabatunde" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="https://www.friendra.com" target="_blank" rel="noreferrer">Friendra ↗</a>
        <a href="tel:+8618583994003">Phone ↗</a>
        <a href={resumeUrl} target="_blank" rel="noreferrer">Résumé ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
